# Copiez ce fichier en ".env" et renseignez vos propres valeurs.
# Le fichier ".env" est ignoré par Git : ne le publiez jamais.
# Ces variables ne servent qu'à l'exécution directe de script.py (test).
# L'application graphique (app.py) enregistre les paramètres dans une base locale.

GSF_EMAIL=votre.email@exemple.com
GSF_PASSWORD=votre_mot_de_passe_gsf
MP_EMAIL=votre.identifiant.marches.publics
MP_PASSWORD=votre_mot_de_passe_marches_publics
MARCHE_NUM=numero_de_la_consultation
LIEN_FICHIER=chemin_ou_lien_du_fichier

